{
  "name": "siga-secult",
  "version": "1.0.0",
  "type": "module",
  "description": "SIGA Secult - Sistema Integrado de Gestão Administrativa (Vercel Monorepo)",
  "private": true,
  "scripts": {
    "install-all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run prisma:seed",
    "smoke": "node smoke-test3.js",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-holidays": "^3.34.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0"
  },
  "author": "Mauricio Davel",
  "license": "MIT"
}
